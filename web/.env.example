# Copy to web/.env.local, or let `npm run db:setup` create it and fill the first three.
# Neon, as the restricted web role (never the owner's connection string, which belongs only in engine/.env)
DATABASE_URL=
# Your dashboard password (8+ characters)
APP_PASSWORD=
# 32+ random characters; signs the session cookie
SESSION_SECRET=
# Upstox login (client id is not secret; the SECRET lives only in engine/.env)
UPSTOX_CLIENT_ID=
# Must match the Upstox app setting and engine/.env exactly
UPSTOX_REDIRECT_URI=http://localhost:3000/api/upstox/callback
