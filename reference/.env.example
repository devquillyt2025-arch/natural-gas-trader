# ---- required ----------------------------------------------------------------
ANTHROPIC_API_KEY=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
# Must match the redirect URI registered in your Upstox developer app exactly.
UPSTOX_REDIRECT_URI=http://localhost:8001/auth/callback

# ---- mode: paper (default) or live ---------------------------------------------
MODE=paper
# Live also needs this exact value. Do not set it until paper results justify it.
LIVE_CONFIRM=

# ---- instrument ----------------------------------------------------------------
# NATGASMINI = 250 mmBtu lot (recommended). NATURALGAS = 1250 mmBtu lot (5x the risk per tick).
SYMBOL=NATGASMINI
MODEL=claude-sonnet-5-5
USE_NEWS=true

# ---- hard risk limits (INR). Enforced in code; Claude cannot override. ---------
MAX_LOTS=1
MAX_RISK_INR=1500
DAILY_LOSS_CAP_INR=3000
MAX_TRADES_PER_DAY=4
MIN_RR=1.5
MIN_CONFIDENCE=0.6

# ---- optional --------------------------------------------------------------------
# If set, kill/resume calls from the dashboard need this token.
ADMIN_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
