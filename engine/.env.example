# Engine configuration. Copy to engine/.env. This file holds every secret; never commit it.

# ---- how Claude is reached -------------------------------------------------------------
# api: billed to ANTHROPIC_API_KEY. subscription: your Claude plan, through the Claude Code
# command-line tool (paper mode only; shares your plan's usage limits). Check with: npm run claude:check
CLAUDE_AUTH=api
# needed when CLAUDE_AUTH=api
ANTHROPIC_API_KEY=
# subscription: the token printed by `claude setup-token` (lasts a year). Empty = this machine's sign-in.
CLAUDE_CODE_OAUTH_TOKEN=
# subscription: path to claude.exe, if it is not found by itself
CLAUDE_CLI=

# ---- required -------------------------------------------------------------------------
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
# Must match the Upstox app setting and the web app's UPSTOX_REDIRECT_URI exactly.
UPSTOX_REDIRECT_URI=https://YOUR-APP.vercel.app/api/upstox/callback

# Neon database: the connection string from the Neon console (it logs in as the database owner).
# After pasting it here run `npm run db:setup`. Optional for a UI-less paper run; REQUIRED for live.
DATABASE_URL=

# ---- mode: paper (default) or live ----------------------------------------------------
MODE=paper
# Live also needs LIVE_CONFIRM=I_ACCEPT_THE_RISK. Leave empty until the go-live checklist passes.
LIVE_CONFIRM=

# ---- instrument -----------------------------------------------------------------------
# NATGASMINI (250 mmBtu per lot, recommended) or NATURALGAS (1250 mmBtu, 5x the risk per tick)
SYMBOL=NATGASMINI
ROLL_DAYS=3
# Candle size in minutes: 15 or 5. Claude decides at every candle close, and the stop limits are measured in
# this candle's ATR. 5 means about 3x as many Claude calls and tighter stops, so costs weigh more.
CANDLE_MIN=15
# Seconds between price checks (stops, daily cap, and how often the chart's live candle moves).
MONITOR_SEC=20

# ---- Claude ---------------------------------------------------------------------------
MODEL=claude-sonnet-5-5
EFFORT=medium
USE_NEWS=true
NEWS_TTL_MIN=60
LLM_TIMEOUT_SEC=60

# ---- hard risk limits (INR). Enforced in code; the model cannot override them. ---------
MAX_LOTS=1
MAX_RISK_INR=1500
DAILY_LOSS_CAP_INR=3000
MAX_TRADES_PER_DAY=4
MIN_RR=1.5
MIN_SL_ATR=0.5
MAX_SL_ATR=3.0
MIN_CONFIDENCE=0.6
COOLDOWN_MIN_AFTER_LOSS=30
ENTRY_START=09:30
NO_ENTRY_AFTER=22:30
EIA_BEFORE_MIN=20
EIA_AFTER_MIN=30
# No later than 23:15
FORCE_FLAT=23:10

# Loosest values the UI may set (unset = the value above, so the UI can only tighten).
# CEIL_MAX_LOTS=
# CEIL_MAX_RISK_INR=
# CEIL_DAILY_LOSS_CAP_INR=
# CEIL_MAX_TRADES_PER_DAY=
# CEIL_MIN_RR=
# CEIL_MIN_SL_ATR=
# CEIL_MAX_SL_ATR=
# CEIL_MIN_CONFIDENCE=
# CEIL_COOLDOWN_MIN_AFTER_LOSS=
# CEIL_EIA_BEFORE_MIN=
# CEIL_EIA_AFTER_MIN=

# ---- calendar -------------------------------------------------------------------------
# EIA holiday shifts not already built in: <regular Thursday>=<new date and time, US Eastern> or =none
# Example: EIA_OVERRIDES=2028-11-09=2028-11-10T10:30
EIA_OVERRIDES=
# Days with no new entries, e.g. exchange holidays: 2027-01-26,2027-03-22
NO_TRADE_DATES=

# ---- paper realism --------------------------------------------------------------------
SLIPPAGE_INR=0.10
COST_PER_LOT_INR=60

# ---- optional -------------------------------------------------------------------------
# Percentage 1-25, or empty to let Upstox choose (-1). Applies to MARKET and SL-M orders.
MARKET_PROTECTION=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# DATA_DIR=/var/lib/natgas
LOG_LEVEL=INFO
